# Backend API origin (no trailing slash). In production, point this at your
# deployed ALB/CloudFront-fronted API, e.g. https://api.example.com
VITE_API_URL=http://localhost:3000

# Socket.IO server origin — usually the same as VITE_API_URL
VITE_SOCKET_URL=http://localhost:3000

# Optional: override the OpenStreetMap tile server
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
