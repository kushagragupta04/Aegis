# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (RDS PostgreSQL + PostGIS in production) ────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/aegis

# ─── Cache / Queues (ElastiCache Redis in production) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change_me_to_a_random_32_char_minimum_secret
REFRESH_TOKEN_SECRET=change_me_to_a_different_random_32_char_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Deployed frontend URL — used to build links inside SMS/push alerts ───────
FRONTEND_URL=http://localhost:5173

# ─── CORS — comma-separated list of allowed origins (HTTP + Socket.IO) ────────
# Leave unset in development (all origins allowed). REQUIRED in production —
# set to your deployed frontend origin(s), e.g. https://app.example.com
CORS_ORIGIN=

# ─── Evidence storage ──────────────────────────────────────────────────────────
# When set, evidence audio chunks are uploaded to this S3 bucket instead of
# local disk. REQUIRED in production (ECS/Fargate) — local container disk is
# ephemeral and does not survive a restart or a second task instance.
# The ECS task role needs s3:PutObject / s3:GetObject / s3:DeleteObject on
# this bucket; no static AWS credentials are needed when running on ECS.
EVIDENCE_S3_BUCKET=
AWS_REGION=us-east-1

# ─── Twilio (optional — SMS alerts are logged to console if unset) ────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Firebase (optional — FCM push is logged to console if unset) ─────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── External Map APIs (public, no key required — defaults shown) ────────────
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_API_URL=https://router.project-osrm.org
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# ─── Cache TTLs (seconds) ──────────────────────────────────────────────────────
MAP_CACHE_TTL_PLACES=600
MAP_CACHE_TTL_ROUTES=300
MAP_CACHE_TTL_GEOCODE=3600

# ─── Evidence storage (local-disk mode only) ──────────────────────────────────
UPLOAD_DIR=./uploads
MAX_EVIDENCE_CHUNK_SIZE_MB=10
EVIDENCE_RETENTION_DAYS=30
